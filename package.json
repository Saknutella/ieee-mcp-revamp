{
  "name": "ieee-mcp",
  "version": "2.0.0",
  "description": "IEEE Xplore Metadata Search MCP server (stdio) delivering a single-file Windows x64 executable",
  "type": "module",
  "private": true,
  "main": "dist/ieee-mcp.exe",
  "bin": {
    "ieee-mcp": "dist/ieee-mcp.exe"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "bundle": "node scripts/bundle.mjs",
    "sea": "node scripts/build-sea.mjs",
    "build": "node scripts/build.mjs",
    "mock-server": "node test/mock-ieee-server.mjs",
    "test": "node test/run-all.mjs",
    "test:e2e": "node test/e2e-mcp.mjs",
    "test:unit": "node test/unit.mjs",
    "checksums": "node scripts/checksums.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.7.0"
  }
}
